# Build products — regenerated by _do_prepare.sh.
# out/goudatijdmachine.nt is ~5 GB and its gzip ~385 MB; never in git.
/out/

# Composer-managed; restore with `composer install`
/vendor/

# Archived copies, kept out of git by convention across this tree
/old/

/doc/

# Logs, and the turtle-URL list _do_update_nt.php drops when run with explicit ids
*.log
_test_urls.txt

# Incremental-harvest watermarks (machine-local state)
*.dat

# Python bytecode
__pycache__/
*.pyc
